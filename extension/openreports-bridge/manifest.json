{
  "manifest_version": 3,
  "name": "Mr. Robot | OpenReports + SharePoint Bridge (0.3.26)",
  "description": "OpenReports automation and manual SharePoint XLSX refresh for Obsada. No scheduled downloads.",
  "version": "0.3.26",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://openreports-wms.lpp.com/*",
    "https://horkiroman4408-cyber.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Mr. Robot | OpenReports",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://openreports-wms.lpp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://horkiroman4408-cyber.github.io/Mr.-Robot-App/*"
      ],
      "js": [
        "i18n.js",
        "calendar.js",
        "time.js",
        "period-store.js",
        "mp-options.js",
        "mrrobot-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://horkiroman4408-cyber.github.io/Mr.-Robot-App/*"
      ],
      "js": [
        "sharepoint-robot-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://lppsa-my.sharepoint.com/*",
    "https://*.officeapps.live.com/*",
    "https://*.office.com/*",
    "https://*.office.net/*"
  ]
}
